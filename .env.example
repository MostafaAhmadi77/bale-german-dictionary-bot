# ===== Bale =====
# توکن ربات از «بات‌فادر بله» (@BotFather در پیام‌رسان بله)
BALE_BOT_TOKEN=

# ===== Database (Leitner box) — Upstash Redis (رایگان) =====
# از console.upstash.com یک دیتابیس Redis بسازید و این دو مقدار را از بخش REST API کپی کنید.
# اگر خالی بماند، داده‌ها موقت و در حافظه ذخیره می‌شوند (فقط برای تست محلی — در ورسل پاک می‌شود!)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Security / Setup =====
# یک رمز دلخواه برای صدا زدن /api/setup (تنظیم وبهوک)
SETUP_SECRET=change-me
# اختیاری: اگر تنظیم شود، آدرس وبهوک باید ?s=همین_مقدار را داشته باشد
WEBHOOK_SECRET=
# ورسل این را خودش برای کرون می‌فرستد؛ یک مقدار تصادفی بگذارید
CRON_SECRET=
